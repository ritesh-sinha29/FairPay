# Convex Deployment Configuration
# Populated automatically when running `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Application Site Origin (configured in Convex deployment and local app)
SITE_URL=http://localhost:3000
FAIRPAY_SITE_URL=http://localhost:3000

# Optional server-side Sepolia RPC endpoint for escrow verification
# Defaults to public RPC if omitted. Never expose wallet private keys here.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional server-side Arc Testnet RPC endpoint, configured in Convex for deployed actions
ARC_RPC_URL=https://rpc.testnet.arc.io

# 6. Arkiv DB-Chain Integration (ETHGlobal Mumbai)
# Free access key can be claimed at https://hub.arkiv.network/access-keys (leave empty for public rate-limited endpoint)
NEXT_PUBLIC_ARKIV_ACCESS_KEY=""
# Dedicated testnet writer wallet address for signing Arkiv entities
NEXT_PUBLIC_ARKIV_WRITER_WALLET="0xE6E4bde21600b3c973E1CB2c6125C2E46bb96d24"
# Optional private key for automated testnet entity seeding
ARKIV_PRIVATE_KEY=""
NEXT_PUBLIC_ARKIV_EXPLORER_URL="https://rabdi.explorer.arkiv.network"
NEXT_PUBLIC_ARKIV_CHAIN_ID=7794095
NEXT_PUBLIC_ARKIV_RPC_URL="https://rpc.rabdi.db-chain.testnet.arkiv.network/"

# 7. Blockscout API Configuration
BLOCKSCOUT_API_KEY=""
NEXT_PUBLIC_BLOCKSCOUT_API_KEY=""
