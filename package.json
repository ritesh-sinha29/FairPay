{
  "name": "fairpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm run contracts:compile && convex deploy --cmd \"next build\"",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "node scripts/compile-contract.mjs",
    "test:contract": "node --test tests/escrow.test.mjs",
    "test:arkiv": "node --test tests/arkiv.test.mjs tests/arkiv-award.test.mjs",
    "test:delivery": "node --test tests/delivery-review.test.mjs",
    "backend:dev": "convex dev",
    "backend:push": "convex dev --once",
    "backend:auth": "node scripts/configure-convex-auth.mjs",
    "test:stablecoin": "node --test tests/stable-escrow.test.mjs",
    "check:arc": "node scripts/check-arc.mjs",
    "contracts:deploy": "node scripts/deploy-contract.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.96",
    "@openzeppelin/contracts": "5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "ethers": "^6.15.0",
    "framer-motion": "^14.10.0",
    "geist": "^1.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.27.0",
    "ganache": "^7.9.2",
    "shadcn": "^3.0.0",
    "solc": "0.8.30",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
